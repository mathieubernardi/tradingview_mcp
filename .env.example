# MCP TradingView — configuration
# Copy this file to .env and fill in your values

# ── TradingView credentials (optional, anonymous has rate limits) ──
TV_TV_USERNAME=
TV_TV_PASSWORD=

# ── Transport: stdio | sse ──
TV_TRANSPORT=stdio

# ── SSE server (used only when TRANSPORT=sse) ──
TV_HOST=127.0.0.1
TV_PORT=8765

# ── Data defaults ──
TV_DEFAULT_EXCHANGE=EURONEXT
TV_DEFAULT_N_BARS=500
TV_MAX_N_BARS=5000

# ── Cache TTL in seconds (0 = disabled) ──
TV_CACHE_TTL_SECONDS=60

# ── Logging: DEBUG | INFO | WARNING | ERROR ──
TV_LOG_LEVEL=INFO
